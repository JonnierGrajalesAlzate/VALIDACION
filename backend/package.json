{
  "name": "appresso-backend",
  "version": "1.0.0",
  "description": "Appresso — API de recepción, validación y detección de anomalías (ventana deslizante)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:integracion": "jest --runInBand tests/integracion",
    "db:schema": "node scripts/ejecutar-sql.js ../database/schema.sql",
    "db:seed": "node scripts/ejecutar-sql.js ../database/seed.sql",
    "db:reset": "node scripts/ejecutar-sql.js ../database/reset.sql ../database/schema.sql ../database/seed.sql",
    "generar:seed": "node scripts/generar-seed.js",
    "generar:datos": "node scripts/generar-datos.js",
    "generar:fixtures-python": "python scripts/hash_profesor.py"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/setup/entornoPruebas.js"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
