# ─── Conexión a PostgreSQL ───────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambia_esta_clave
PGDATABASE=ACTIVIDAD_PA
# Base de datos EXCLUSIVA para las pruebas (se borra y se recrea en cada corrida de Jest)
PGDATABASE_TEST=actividad_pa_test

# ─── Seguridad ───────────────────────────────────────────────────────
# Llave del HMAC-SHA256. Debe ser la MISMA que usa el profesor para generar los hash.
HMAC_SECRET=appresso-secreto-desarrollo

# ─── Servidor ────────────────────────────────────────────────────────
PORT=3000
# development | production | test   (el endpoint /api/dev/calcular-hash solo existe en development)
NODE_ENV=development
# Zona horaria del negocio: se asume para fechas sin zona y se usa en franjas y dashboard
TZ_NEGOCIO=America/Bogota

# ─── Logs ────────────────────────────────────────────────────────────
# error | warn | info | debug   (en debug se loguea la cadena exacta que se firmó con HMAC)
LOG_LEVEL=info
# Ruta opcional del archivo de reglas (ventana, umbral, franjas...). Por defecto config/reglas.json
# REGLAS_PATH=config/reglas.json
